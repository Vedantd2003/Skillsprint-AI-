# Public config only — anything prefixed EXPO_PUBLIC_ is bundled into the app.
# Never put secrets (Gemini key, DB URI) here.
#
# Android emulator talking to a backend on your computer:
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# Physical phone on the same Wi-Fi (use your computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
# Production (Render):
# EXPO_PUBLIC_API_URL=https://skillsprint-api.onrender.com/api/v1
