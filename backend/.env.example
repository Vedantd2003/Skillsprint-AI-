# ---------- Server ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (native apps send no Origin header).
CORS_ORIGINS=http://localhost:8081
# Number of proxy hops in front of the app (Render = 1).
TRUST_PROXY=1

# ---------- Database ----------
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillsprint?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillsprint

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Development only: return password-reset codes in the API response (no email provider configured).
EXPOSE_DEV_RESET_TOKEN=false

# ---------- AI (Google Gemini) ----------
# gemini | mock   (mock = deterministic offline responses for local UI work)
AI_PROVIDER=gemini
# Create a key at https://aistudio.google.com/apikey — server-side only, never in the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_REQUEST_LIMIT=60
AI_PER_MINUTE_LIMIT=10
# Approximate USD per million tokens, used only for cost estimates in /admin/metrics.
AI_INPUT_COST_PER_MTOK=0.3
AI_OUTPUT_COST_PER_MTOK=2.5
AI_MESSAGE_RETENTION_DAYS=180

# ---------- Gamification ----------
XP_LESSON_DEFAULT=15
XP_PERFECT_BONUS=5
XP_REPLAY=3
XP_AI_QUIZ=8
XP_REVISION_SESSION=5
HEARTS_MAX=5
HEART_REFILL_MINUTES=30
DEFAULT_TIMEZONE=Asia/Kolkata
RATE_LIMIT_DISABLED=false
